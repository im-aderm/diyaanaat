# ═══════════════════════════════════════════════════
#  Railway Deployment Environment Variables
# ═══════════════════════════════════════════════════
# Copy or symlink this to .env after deploying via Railway CLI:
#   railway login
#   railway link
#   railway run -- cp .env.railway.example backend/.env
# ═══════════════════════════════════════════════════

# --- Database (Railway PostgreSQL Plugin) ---
# Railway automatically injects DATABASE_URL when PostgreSQL plugin is attached.
# Format: postgresql://user:password@host:port/db?schema=public
DATABASE_URL=

# --- JWT ---
JWT_SECRET=generate-a-strong-random-secret-here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=generate-another-strong-random-secret-here
JWT_REFRESH_EXPIRATION=7d

# --- Backend ---
PORT=3001
NODE_ENV=production
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880
ALLOWED_ORIGINS=https://frontend.railway.app

# --- Frontend (build-time, set in Railway service env vars) ---
# NEXT_PUBLIC_API_URL is now optional — uses relative /api/v1 via rewrites.
# Set API_PROXY_TARGET to the backend's Railway internal URL:
#   https://backend.<your-project>.up.railway.app
# or use Railway service references:
#   ${{backend.RAILWAY_PUBLIC_DOMAIN}}
#
# If using Railway service references, prefix with https://
#   API_PROXY_TARGET=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
#
# Leave empty or unset to default to http://localhost:3001 (dev mode)
API_PROXY_TARGET=
