generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  DISTRIBUTION_ACTIVE
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  CENTER_ADMIN
}

enum BeneficiaryType {
  INDIVIDUAL
  ORGANIZATION
}

enum OrganizationType {
  SCHOOL
  MASJID
  NGO
}

enum BeneficiaryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CowStatus {
  PURCHASED
  ASSIGNED
  SLAUGHTERED
  DISTRIBUTED
}

enum DistributionDay {
  DAY_10
  DAY_11
  DAY_12
}

model Session {
  id                   String        @id @default(uuid()) @db.Uuid
  gregorianYear        Int
  hijriYear            Int
  name                 String
  registrationOpenDate DateTime
  registrationCloseDate DateTime
  distributionStartDate DateTime
  distributionEndDate   DateTime
  status               SessionStatus @default(DRAFT)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  beneficiaries Beneficiary[]
  cows          Cow[]
  distributions Distribution[]
  auditLogs     AuditLog[]
  smsLogs       SmsLog[]

  @@unique([gregorianYear])
  @@map("sessions")
}

model Center {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  address   String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centerStates  CenterState[]
  userCenters   UserCenter[]
  beneficiaries Beneficiary[]
  cows          Cow[]
  suppliers     Supplier[]
  auditLogs     AuditLog[]

  @@map("centers")
}

model State {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique
  code      String @unique
  createdAt DateTime @default(now())

  lgas          Lga[]
  centerStates  CenterState[]
  beneficiaries Beneficiary[]
  suppliers     Supplier[]

  @@map("states")
}

model Lga {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  stateId   String   @db.Uuid
  createdAt DateTime @default(now())

  state         State         @relation(fields: [stateId], references: [id])
  beneficiaries Beneficiary[]

  @@unique([name, stateId])
  @@map("lgas")
}

model CenterState {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @db.Uuid
  stateId   String   @db.Uuid
  createdAt DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id])
  state  State  @relation(fields: [stateId], references: [id])

  @@unique([centerId, stateId])
  @@map("center_states")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  fullName       String
  passwordHash   String
  role           UserRole  @default(CENTER_ADMIN)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userCenters            UserCenter[]          @relation("UserCenters")
  approvedBeneficiaries  Beneficiary[]         @relation("ApprovedBy")
  auditLogs              AuditLog[]            @relation("Actor")
  distributions          Distribution[]

  @@map("users")
}

model UserCenter {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  centerId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation("UserCenters", fields: [userId], references: [id])
  center Center @relation(fields: [centerId], references: [id])

  @@unique([userId, centerId])
  @@map("user_centers")
}

model Beneficiary {
  id                    String            @id @default(uuid()) @db.Uuid
  sessionId             String            @db.Uuid
  centerId              String            @db.Uuid
  type                  BeneficiaryType   @default(INDIVIDUAL)
  fullName              String
  phoneNumber           String
  address               String
  stateId               String            @db.Uuid
  lgaId                 String            @db.Uuid
  vulnerabilityCategory String?
  organizationType      OrganizationType?
  organizationName      String?
  guarantorName         String?
  guarantorPhone        String?
  requestedSlots        Int               @default(1)
  approvedSlots         Int?
  status                BeneficiaryStatus @default(PENDING)
  uniqueCode            String?           @unique
  rejectionReason       String?
  distributionDay       DistributionDay?
  distributionTime      String?
  approvedById          String?           @db.Uuid
  approvedAt            DateTime?
  collectedAt           DateTime?
  collectedById         String?           @db.Uuid
  isFirstTime           Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  session     Session              @relation(fields: [sessionId], references: [id])
  center      Center               @relation(fields: [centerId], references: [id])
  state       State                @relation(fields: [stateId], references: [id])
  lga         Lga                  @relation(fields: [lgaId], references: [id])
  approvedBy  User?                @relation("ApprovedBy", fields: [approvedById], references: [id])
  documents     BeneficiaryDocument[]
  auditLogs     AuditLog[]
  distributions Distribution[]
  smsLogs       SmsLog[]

  @@unique([phoneNumber, sessionId])
  @@unique([organizationName, sessionId])
  @@map("beneficiaries")
}

model BeneficiaryDocument {
  id            String   @id @default(uuid()) @db.Uuid
  beneficiaryId String   @db.Uuid
  type          String
  filePath      String
  originalName  String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id])

  @@map("beneficiary_documents")
}

model SmsLog {
  id            String    @id @default(uuid()) @db.Uuid
  beneficiaryId String?   @db.Uuid
  sessionId     String?   @db.Uuid
  phoneNumber   String
  message       String
  template      String?
  status        String    @default("pending")
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())

  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  session     Session?     @relation(fields: [sessionId], references: [id])

  @@map("sms_logs")
}

model SmsTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  subject   String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sms_templates")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  action       String
  entityType   String
  entityId     String?
  sessionId    String?  @db.Uuid
  centerId     String?  @db.Uuid
  oldValue     String?
  newValue     String?
  ipAddress    String?
  userAgent    String?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  beneficiaryId String? @db.Uuid

  actor       User?        @relation("Actor", fields: [actorId], references: [id])
  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  session     Session?     @relation(fields: [sessionId], references: [id])
  center      Center?      @relation(fields: [centerId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @db.Uuid
  name      String
  phone     String?
  address   String?
  stateId   String?  @db.Uuid
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center Center @relation(fields: [centerId], references: [id])
  state  State? @relation(fields: [stateId], references: [id])
  cows   Cow[]

  @@map("suppliers")
}

model Cow {
  id               String    @id @default(uuid()) @db.Uuid
  centerId         String    @db.Uuid
  supplierId       String    @db.Uuid
  sessionId        String    @db.Uuid
  tagNumber        String    @unique
  purchaseDate     DateTime?
  purchaseCost     Decimal?  @db.Decimal(12, 2)
  estimatedYield   Int?
  healthStatus     String?
  status           CowStatus @default(PURCHASED)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  center   Center   @relation(fields: [centerId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  session  Session  @relation(fields: [sessionId], references: [id])

  @@map("cows")
}

model Distribution {
  id            String         @id @default(uuid()) @db.Uuid
  beneficiaryId String         @db.Uuid
  sessionId     String         @db.Uuid
  code          String
  day           DistributionDay
  time          String
  verifiedById  String?        @db.Uuid
  verifiedAt    DateTime?
  collected     Boolean        @default(false)
  collectedById String?        @db.Uuid
  collectedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id])
  session     Session     @relation(fields: [sessionId], references: [id])
  verifiedBy  User?       @relation(fields: [verifiedById], references: [id])

  @@unique([code, sessionId])
  @@map("distributions")
}
